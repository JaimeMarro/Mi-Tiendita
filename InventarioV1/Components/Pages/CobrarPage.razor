@page "/cobrar"
@inject PupuseriaService Service
@inject NavigationManager Navigation

<div class="page-header-bar">
    <button class="btn-back" @onclick="Volver">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
        </svg>
    </button>
    <span class="app-titulo">Cobrar</span>
</div>

<div class="cobrar-page">

    <div class="cobrar-total-box">
        <div class="cobrar-total-label">TOTAL A PAGAR</div>
        <div class="cobrar-total-monto">$@Total.ToString("0.00")</div>
    </div>

    <div class="form-group">
        <label>Paga con:</label>
        <div class="billetes-rapidos">
            @foreach (var billete in billetes)
            {
                <button class="@(pagaCon == billete ? "btn-billete selected" : "btn-billete")"
                        @onclick="() => SeleccionarBillete(billete)">
                    $@billete
                </button>
            }
        </div>
    </div>

    <div class="form-group">
        <div class="precio-input-wrapper">
            <span class="precio-simbolo">$</span>
            <input class="form-input"
                   type="number"
                   step="0.25"
                   min="0"
                   placeholder="0.00"
                   value="@pagaConTexto"
                   @oninput="OnPagaConInput" />
        </div>
    </div>

    @if (pagaCon >= Total)
    {
        <div class="cambio-box">
            <div class="cambio-label">Cambio a entregar:</div>
            <div class="cambio-monto">$@Cambio.ToString("0.00")</div>
        </div>

        <button class="btn-completar" @onclick="CompletarVenta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;">
                <polyline points="20 6 9 17 4 12" />
            </svg>
            VENTA COMPLETADA
        </button>
    }
    else if (pagaCon > 0)
    {
        <div class="cambio-box" style="background:#fff0f0;">
            <div class="cambio-label" style="color:#e53935;">Falta por pagar:</div>
            <div class="cambio-monto" style="color:#e53935;">
                $@((Total - pagaCon).ToString("0.00"))
            </div>
        </div>
    }

    <button class="btn-secondary" @onclick="Volver">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;vertical-align:-3px;margin-right:4px;">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
        </svg>
        Volver
    </button>

</div>

@code {
    [SupplyParameterFromQuery] public string? Items { get; set; }

    private List<(Producto producto, int cantidad)> itemsVenta = new();
    private decimal Total => itemsVenta.Sum(i => i.producto.Precio * i.cantidad);
    private decimal pagaCon = 0;
    private string pagaConTexto = string.Empty;
    private decimal Cambio => pagaCon - Total;
    private List<decimal> billetes = new() { 1, 5, 10, 20 };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Items)) return;

        var productos = await Service.GetProductosAsync();
        var partes = Items.Split(',');

        foreach (var parte in partes)
        {
            var kv = parte.Split(':');
            if (kv.Length == 2 &&
                int.TryParse(kv[0], out var id) &&
                int.TryParse(kv[1], out var cant))
            {
                var producto = productos.FirstOrDefault(p => p.Id == id);
                if (producto != null)
                    itemsVenta.Add((producto, cant));
            }
        }
    }

    private void SeleccionarBillete(decimal billete)
    {
        pagaCon = billete;
        pagaConTexto = billete.ToString("0.##",
            System.Globalization.CultureInfo.InvariantCulture);
    }

    private void OnPagaConInput(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString() ?? string.Empty;
        if (decimal.TryParse(valor, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            pagaCon = Math.Round(parsed, 2);
            pagaConTexto = pagaCon == 0 ? string.Empty : pagaCon.ToString("0.##",
                System.Globalization.CultureInfo.InvariantCulture);
        }
        else
        {
            pagaCon = 0;
            pagaConTexto = string.Empty;
        }
    }

    private async Task CompletarVenta()
    {
        await Service.RegistrarVentaAsync(itemsVenta, pagaCon);
        Navigation.NavigateTo("/vender");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/vender");
    }
}