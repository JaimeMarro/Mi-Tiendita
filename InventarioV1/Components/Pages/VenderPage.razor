@page "/vender"
@inject PupuseriaService Service
@inject NavigationManager Navigation

<div class="vender-header">
    <span class="app-titulo">Mi Tiendita</span>
    <button @onclick="CerrarApp" style="margin-left:auto; background:none; border:none;
        font-size:20px; cursor:pointer; color:#aaa; display:flex; align-items:center;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
    </button>
</div>

<div class="categorias-tabs">
    <button class="@(categoriaActiva == null ? "tab activa" : "tab")"
            @onclick="() => FiltrarCategoria(null)">
        Todos
    </button>
    @foreach (var cat in categorias)
    {
        <button class="@(categoriaActiva?.Id == cat.Id ? "tab activa" : "tab")"
                @onclick="() => FiltrarCategoria(cat)">
            @cat.Nombre
        </button>
    }
</div>

@if (productosFiltrados == null)
{
    <p class="sin-productos">Cargando...</p>
}
else if (!productosFiltrados.Any())
{
    <p class="sin-productos">No hay productos. ¡Agregá desde Inventario!</p>
}
else
{
    <div class="productos-lista">
        @foreach (var producto in productosFiltrados)
        {
            <div class="producto-vender-card">
                <div class="producto-vender-info">
                    <span class="producto-vender-nombre">@producto.Nombre</span>
                    <div class="cantidad-control">
                        <button class="btn-cantidad menos"
                                @onclick="() => Decrementar(producto)">
                            −
                        </button>
                        <span class="cantidad-num">@ObtenerCantidad(producto)</span>
                        <button class="btn-cantidad mas"
                                @onclick="() => Incrementar(producto)">
                            +
                        </button>
                    </div>
                </div>
                <span class="producto-vender-precio">$@producto.Precio.ToString("0.00")</span>
                @if (!string.IsNullOrEmpty(producto.ImagenBase64))
                {
                    <img src="@producto.ImagenBase64" class="producto-vender-img" />
                }
                else
                {
                    <div class="producto-placeholder">🫓</div>
                }
            </div>
        }
    </div>
}

@if (carrito.Any())
{
    <div class="barra-cobrar">
        <div>
            <div class="barra-total-label">TOTAL A PAGAR</div>
            <div class="barra-total-monto">$@Total.ToString("0.00")</div>
        </div>
        <button class="btn-cobrar" @onclick="IrACobrar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;">
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <line x1="2" y1="10" x2="22" y2="10" />
            </svg>
            COBRAR
        </button>
    </div>
}

@code {
    private List<Producto> todosLosProductos = new();
    private List<Producto> productosFiltrados = new();
    private List<Categoria> categorias = new();
    private Categoria? categoriaActiva;
    private Dictionary<int, int> carrito = new();

    private decimal Total => carrito.Sum(kvp =>
    {
        var producto = todosLosProductos.FirstOrDefault(p => p.Id == kvp.Key);
        return producto != null ? producto.Precio * kvp.Value : 0;
    });

    protected override async Task OnInitializedAsync()
    {
        todosLosProductos = await Service.GetProductosAsync();
        categorias = await Service.GetCategoriasAsync();
        productosFiltrados = todosLosProductos;
    }

    private void FiltrarCategoria(Categoria? cat)
    {
        categoriaActiva = cat;
        productosFiltrados = cat == null
            ? todosLosProductos
            : todosLosProductos.Where(p => p.CategoriaId == cat.Id).ToList();
    }

    private void Incrementar(Producto p)
    {
        if (carrito.ContainsKey(p.Id))
            carrito[p.Id]++;
        else
            carrito[p.Id] = 1;
    }

    private void Decrementar(Producto p)
    {
        if (!carrito.ContainsKey(p.Id)) return;
        carrito[p.Id]--;
        if (carrito[p.Id] <= 0)
            carrito.Remove(p.Id);
    }

    private int ObtenerCantidad(Producto p) =>
        carrito.TryGetValue(p.Id, out var c) ? c : 0;

    private void IrACobrar()
    {
        var items = carrito
            .Select(kvp => $"{kvp.Key}:{kvp.Value}")
            .ToList();
        var query = string.Join(",", items);
        Navigation.NavigateTo($"/cobrar?items={query}");
    }

    private void CerrarApp()
    {
        Application.Current?.Quit();
    }
}